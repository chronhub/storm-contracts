{
    "name": "chronhub/storm-contracts",
    "description": "Storm Contracts — the pure interfaces shared across Storm packages.",
    "type": "library",
    "license": "MIT",
    "keywords": ["ddd", "cqrs", "event-sourcing", "contracts"],
    "require": {
        "php": ">=8.5",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2.16",
        "phpunit/phpunit": "^13.4.0"
    },
    "autoload": {
        "psr-4": {
            "Storm\\Contracts\\": "./"
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Storm\\Contracts\\Tests\\": "Tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
